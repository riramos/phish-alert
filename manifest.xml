<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>b388e19c-97b3-434b-b61f-00bab411f50e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Canvia Ciberseguridad</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Reportar Phishing"/>
  <Description DefaultValue="Reporta correos sospechosos al equipo de Ciberseguridad de Canvia."/>
  <IconUrl DefaultValue="https://riramos.github.io/phish-alert/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://riramos.github.io/phish-alert/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://riramos.github.io/phish-alert/"/>

  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://graph.microsoft.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://riramos.github.io/phish-alert/"/>
        <RequestedHeight>400</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!--
    IMPORTANTE: ReadWriteMailbox (en vez de ReadItem) es requerido para
    poder usar Office.context.mailbox.makeEwsRequestAsync() y reenviar
    el correo reportado (como adjunto .eml) al buzon de reporte del SOC.
  -->
  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="And">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="funcUrl"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="canviaGroup">
                <Label resid="groupLabel"/>
                <Control xsi:type="Button" id="canviaBtn">
                  <Label resid="btnLabel"/>
                  <Supertip>
                    <Title resid="btnLabel"/>
                    <Description resid="btnDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://riramos.github.io/phish-alert/assets/icon-16.png"/>
        <bt:Image id="icon32" DefaultValue="https://riramos.github.io/phish-alert/assets/icon-32.png"/>
        <bt:Image id="icon80" DefaultValue="https://riramos.github.io/phish-alert/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="funcUrl"     DefaultValue="https://riramos.github.io/phish-alert/"/>
        <bt:Url id="taskpaneUrl" DefaultValue="https://riramos.github.io/phish-alert/"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Ciberseguridad"/>
        <bt:String id="btnLabel"   DefaultValue="Reportar Phishing"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="btnDesc" DefaultValue="Reporta este correo como phishing o sospechoso al equipo de Ciberseguridad de Canvia."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
